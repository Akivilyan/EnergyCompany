{
  "name": "energy-company",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:client": "node scripts/sync-client-assets.mjs",
    "build:client:bundle": "node scripts/sync-client-assets.mjs --skip-config",
    "build:client:config": "node scripts/sync-client-assets.mjs --skip-bundle",
    "build:client:clean": "node scripts/sync-client-assets.mjs --force",
    "build:client:watch": "node scripts/watch-client-assets.mjs",
    "doctor": "node scripts/doctor.mjs",
    "doctor:full": "node scripts/doctor-full.mjs",
    "tool:cocos": "node scripts/open-cocos.mjs",
    "tool:wechat": "node scripts/open-wechat-devtools.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim:demo": "tsx src/app/cli.ts",
    "sim:city-loop": "tsx src/app/cityLoopCli.ts",
    "sim:region-loop": "tsx src/app/regionLoopCli.ts",
    "sim:tech-loop": "tsx src/app/techLoopCli.ts",
    "sim:events-loop": "tsx src/app/eventsLoopCli.ts",
    "sim:result-loop": "tsx src/app/resultLoopCli.ts",
    "sim:tutorial-loop": "tsx src/app/tutorialLoopCli.ts",
    "sim:save-loop": "tsx src/app/saveLoopCli.ts",
    "sim:regression": "tsx src/app/regressionCli.ts",
    "sim:fast-demo-route": "tsx src/app/fastDemoRouteCli.ts",
    "sim:map-expansion-route": "tsx src/app/mapExpansionRouteCli.ts",
    "sim:company-progression-route": "tsx src/app/companyProgressionRouteCli.ts",
    "sim:city-branches-route": "tsx src/app/cityBranchesRouteCli.ts",
    "sim:tech-effects-route": "tsx src/app/techEffectsRouteCli.ts",
    "sim:disaster-pressure-route": "tsx src/app/disasterPressureRouteCli.ts",
    "sim:telemetry-export": "tsx src/app/telemetryExportCli.ts",
    "sim:ad-sdk-spike": "tsx src/app/adSdkSpikeCli.ts",
    "sim:playtest-bundle": "tsx src/app/playtestBundleCli.ts",
    "sim:app-shell": "tsx src/app/appShellCli.ts",
    "sim:cocos-scene-spike": "tsx src/app/cocosSceneSpikeCli.ts",
