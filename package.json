    "sim:client-sync-spike": "tsx src/app/clientSyncSpikeCli.ts",
    "sim:cocos-hud-close": "tsx src/app/cocosHudCloseSpikeCli.ts",
    "verify:client": "tsx src/app/verifyClientCli.ts",
    "verify:client:fast": "tsx src/app/verifyClientFastCli.ts",
    "check:cocos-preview": "tsx src/app/previewProbeCli.ts",
    "lint:boundaries": "node scripts/check-sim-boundaries.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
